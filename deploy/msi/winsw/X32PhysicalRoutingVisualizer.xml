<!--
  WinSW (https://github.com/winsw/winsw) service configuration.

  node.exe cannot speak the Windows Service Control Protocol directly, so
  WinSW is the service binary the SCM actually launches (registered by the
  MSI's ServiceInstall — see deploy/msi/Product.wxs); WinSW in turn spawns
  and supervises `node.exe server.mjs` as its child process.

  This file must sit next to the renamed WinSW executable
  (X32PhysicalRoutingVisualizer.exe) with the SAME basename — that is how WinSW
  finds its config, there is no path passed on the command line.

  All paths below are static/hardcoded because the MSI never offers a custom
  install-directory UI (WixUI_Minimal, no directory picker): the install
  location is always "%ProgramFiles%\X32 Physical Routing Visualizer" and the state
  directory is always "%ProgramData%\X32PhysicalRoutingVisualizer" (both standard,
  version-independent Windows folders). If a future step adds a directory
  picker, this file must become build-time-generated instead of static.

  %BASE% is resolved by WinSW itself to the directory containing this file
  (and the renamed exe) — i.e. the MSI's INSTALLFOLDER — so node.exe and
  server.mjs are found there without hardcoding the install path here.
-->
<service>
  <id>X32PhysicalRoutingVisualizer</id>
  <name>X32 Physical Routing Visualizer</name>
  <description>Serves the X32 physical routing visualizer web UI and bridges to the console (read-only; never writes to the mixer).</description>

  <executable>%BASE%\node.exe</executable>
  <arguments>server.mjs</arguments>
  <workingdirectory>%BASE%</workingdirectory>

  <!-- No X32_HOST: the bridge auto-discovers the console on the LAN
       (plan step 18). Venue-specific overrides (X32_HOST, X32_BRIDGE_PORT)
       live in the OPTIONAL settings.env below, not here — hand-editing this
       file is not the supported override path. -->
  <env name="X32_MIXER" value="x32"/>
  <env name="X32_WEB_DIST" value="%BASE%\web"/>
  <env name="X32_BASELINE_FILE" value="C:\ProgramData\X32PhysicalRoutingVisualizer\baseline.json"/>
  <env name="X32_SETTINGS_FILE" value="C:\ProgramData\X32PhysicalRoutingVisualizer\settings.env"/>

  <!-- No X32_INSTALLATION_FILE: since issue #26 the bridge already reads
       C:\ProgramData\X32PhysicalRoutingVisualizer\installation.yaml by default. It
       derives that from X32_BASELINE_FILE's directory (the state directory),
       so the venue's topology and its blessed baseline always live together,
       in the one directory the MSI never removes or overwrites. First run
       creates the file from the read-only copy in %BASE%\config\ and never
       overwrites it afterwards, so venue edits survive every upgrade.

       Set X32_INSTALLATION_FILE in settings.env (not here) only to put the
       file somewhere else entirely.
  <env name="X32_INSTALLATION_FILE" value="C:\ProgramData\X32PhysicalRoutingVisualizer\installation.yaml"/>
  -->

  <logpath>C:\ProgramData\X32PhysicalRoutingVisualizer</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>5120</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>

  <onfailure action="restart" delay="5 sec"/>
</service>
